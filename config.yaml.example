soulseek:
  address: vps.slsknet.org
  port: 2271
  listen_port: 50300 # if changed, also change the port in docker-compose.yaml
  # A new account is created automatically the first time an unused name logs in.
  # Left as YourUsername / YourPassword, a random name (like HorseTomatoPunctually4256) and password
  # are made on first start and saved here.
  username: YourUsername
  password: YourPassword
  description: |
    This is my multiline
    account description
downloads:
  downloads_folder: ./downloads # with Docker, set by the volume in docker-compose.yaml
  # Where admins' songs are saved, each playlist in a folder named after it. Left empty, they go in
  # the downloads folder too.
  # With Docker, write the folder's path inside the containers (like /music) and mount it at that
  # same path in both the app and slskd services in docker-compose.yaml.
  server_folder:
  share: True # if the downloads folder and server folder should be shared on Soulseek. Set False when
              # they are already inside one of extra_shares, so they aren't shared twice.
  # More folders to share on Soulseek, as slskd sees them. "[Name]/path" shows /path as Name.
  # With Docker, mount each one into the slskd service in docker-compose.yaml (read only is fine).
  extra_shares: []
  #  - "[Movies]/movies"
  max_file_age: 7 # days. Files fetched for visitors' browsers are deleted after this long (0 keeps them).
                  # Songs the admins save into folders are never deleted.
webserver:
  # ip and port only apply outside Docker; with Docker, edit the ports in docker-compose.yaml
  ip: 0.0.0.0
  port: 8080
  https: False # True uses certs/cert.pem and certs/key.pem, or makes a self-signed pair
  rate_limiting: True
  rate_limit: 5 # searches and playlist uploads per minute each visitor IP can start
  trust_proxy: False # True when behind Cloudflare or another reverse proxy: take the visitor's IP and
                     # scheme from CF-Connecting-IP / X-Forwarded-For / X-Forwarded-Proto. Only turn this
                     # on if the site can't be reached except through that proxy.
  # Admins can sign in at /login/ to save playlists on the server (Download as on the home page) and
  # manage the queue (Downloads page). Passwords must be at least 8 characters. Left as change-me-please,
  # a random 32 character password is made on first start and saved here.
  # Add a line per admin, each with their own name and password; the queue shows who added what.
  # Remove the users to turn the admin pages off.
  admins:
    admin: change-me-please
  #  someone-else: change-me-please
  # Optional Cloudflare Turnstile on the admin sign-in. Create a widget at
  # https://dash.cloudflare.com/?to=/:account/turnstile and paste both keys.
  turnstile:
    site_key:
    secret_key:
captcha:
  # Some uploaders hold their files until you message back a keyword, e.g. 'type "download" in this chat
  # to prove you are human'. A small AI model (the llm container) reads messages from uploaders we asked
  # for a file and sends back only that keyword. Any other message is never answered.
  # Off by default. To turn it on, set True and start with: sudo docker compose --profile captcha up -d
  # The model (about 1 GB) is downloaded into models/ the first time the llm container starts.
  enabled: False
# Advanced: more slskd settings (https://github.com/slskd/slskd/blob/master/docs/config.md), merged
# into the slskd.yml that Song-DL writes. Song-DL's own settings win where both set something.
slskd: {}
#  transfers:
#    upload:
#      slots: 20
#      speed_limit: 10000 # KiB/s
